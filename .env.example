# Environment variables for ShopSense
# Adjust as needed for production
PYTHON_API_PORT=8000
JWT_SECRET=your_production_secret_here
CLIENT_ORIGIN=http://localhost:5173
APP_ENV=production
# Optional first-administrator bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_NAME=ShopSense Administrator
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# Local demo accounts are optional and are accepted only with APP_ENV=development.
# Uncomment and customize these values in your ignored local .env file.
# DEMO_ADMIN_EMAIL=admin@demo.local
# DEMO_ADMIN_PASSWORD=ShopSenseDemo!2026
# DEMO_VENDOR_EMAIL=vendor@demo.local
# DEMO_VENDOR_PASSWORD=VendorDemo!2026
# Optional AI answer generation (Gemini takes precedence over OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# SQLite DB path (relative to project root, for the Python service)
DB_PATH=./server/db/shopsense.db
